# Local development. Copy to `.env` — that file is gitignored.
# Production values live in the Pi's docker-compose.yml and ~/apps/hsa/.env.

# Who you are in dev. Authentication is bypassed unless FORCE_ACCESS=1.
# Matched case-insensitively against the users table.
DEV_EMAIL=you@example.com

# SQLite file and upload directory. Both are created on first run.
DATABASE_PATH=data/hsa.db
UPLOAD_ROOT=data/uploads

# adapter-node defaults to 512K, which rejects phone photos.
BODY_SIZE_LIMIT=15M

# Cloudflare Access. Only needed in production, or with FORCE_ACCESS=1.
CF_ACCESS_TEAM_DOMAIN=https://yourteam.cloudflareaccess.com
CF_ACCESS_AUD=
# FORCE_ACCESS=1
